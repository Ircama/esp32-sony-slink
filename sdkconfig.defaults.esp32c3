# ESP32-C3 only (idf.py picks this file up by itself; with PlatformIO it is listed in platformio.ini).
# No PSRAM and 400 KB of SRAM: with WiFi + web portal + Bluetooth the free internal RAM was 7-10 KB (minimum under 1 KB), the portal stopped
# answering and HTTPS could not start. What the "Minimizing RAM usage" chapter of the ESP-IDF guide suggests, in the order of how much it gives:

# code that ESP-IDF copies into the internal RAM (IRAM) for speed: it shares the SRAM with the heap. Not needed at the speeds of this device.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_LWIP_IRAM_OPTIMIZATION=n
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y

# WiFi: station only (no access point), fewer and smaller buffers
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=4
CONFIG_ESP_WIFI_TX_BA_WIN=4
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16

# lwIP: IPv4 only, smaller TCP windows (the portal sends small messages). The number of sockets stays at 16 (sdkconfig.defaults): with 10 the HTTP and
# HTTPS servers (open connections + listening and control sockets), mDNS and the Hue SSDP socket did not fit and the portal stopped answering after HUE ON.
CONFIG_LWIP_IPV6=n
CONFIG_LWIP_MAX_LISTENING_TCP=8
CONFIG_LWIP_MAX_UDP_PCBS=8
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=2880
CONFIG_LWIP_TCP_WND_DEFAULT=2880
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16

# TLS: the record buffers are allocated while a record is being handled and freed after, not kept for each connection
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_PEER_CERT=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
# records received from the browser up to 4 KB (the portal sends small requests; a firmware upload over HTTPS needs 16 KB records: use http:// for it on this chip)
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=4096
